{
  "manifest_version": 3,
  "name": "Фокус-вкладка",
  "short_name": "Фокус",
  "version": "1.0.0",
  "description": "Помодоро-таймер и блокировка отвлекающих сайтов на время работы, расписание и статистика.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "alarms", "declarativeNetRequest", "notifications"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Фокус-вкладка",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "options_page": "options.html",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "web_accessible_resources": [
    { "resources": ["blocked.html"], "matches": ["<all_urls>"] }
  ]
}
